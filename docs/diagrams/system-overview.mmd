flowchart LR

    CLIENT["API Client"]

    subgraph CONTROL["FORGE CONTROL PLANE"]
        direction LR

        API["REST API<br/><small>Spring Boot · :8080</small>"]

        CORE["Workflow Engine<br/><small>DAG orchestration · retries · recovery</small>"]

        SCHED["Scheduler<br/><small>attempt placement</small>"]

        GRPC["gRPC Gateway<br/><small>bidirectional · :50051</small>"]

        API --> CORE
        CORE --> SCHED
        SCHED --> GRPC
    end

    DB[("PostgreSQL<br/><small>durable system state</small>")]

    subgraph EXECUTION["EXECUTION PLANE"]
        direction TB

        W1["Worker A<br/><small>C++20</small>"]
        W2["Worker B<br/><small>C++20</small>"]
        W3["Worker C<br/><small>C++20</small>"]
    end

    CLIENT -->|"HTTP / JSON"| API

    CORE --> DB
    SCHED --> DB

    GRPC <-->|"tasks + events"| W1
    GRPC <-->|"tasks + events"| W2
    GRPC <-->|"tasks + events"| W3


    classDef client fill:#ffffff,stroke:#94a3b8,color:#334155,stroke-width:1.5px;
    classDef control fill:#eff6ff,stroke:#60a5fa,color:#172554,stroke-width:1.5px;
    classDef database fill:#f5f3ff,stroke:#a78bfa,color:#4c1d95,stroke-width:1.5px;
    classDef worker fill:#ecfdf5,stroke:#6ee7b7,color:#064e3b,stroke-width:1.5px;

    class CLIENT client;
    class API,CORE,SCHED,GRPC control;
    class DB database;
    class W1,W2,W3 worker;

    style CONTROL fill:#f8fafc,stroke:#cbd5e1,stroke-width:1px
    style EXECUTION fill:#f8fafc,stroke:#cbd5e1,stroke-width:1px
