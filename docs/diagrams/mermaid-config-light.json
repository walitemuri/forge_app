{
  "theme": "base",
  "look": "classic",
  "flowchart": {
    "curve": "basis",
    "htmlLabels": true,
    "nodeSpacing": 55,
    "rankSpacing": 70,
    "padding": 20
  },
  "sequence": {
    "actorMargin": 70,
    "messageMargin": 38,
    "mirrorActors": false
  },
  "themeVariables": {
    "fontFamily": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif",
    "fontSize": "14px",

    "background": "#f6f8fa",

    "primaryColor": "#ffffff",
    "primaryTextColor": "#24292f",
    "primaryBorderColor": "#8c959f",

    "secondaryColor": "#f6f8fa",
    "secondaryTextColor": "#24292f",
    "secondaryBorderColor": "#afb8c1",

    "tertiaryColor": "#ffffff",
    "tertiaryTextColor": "#57606a",
    "tertiaryBorderColor": "#d0d7de",

    "lineColor": "#57606a",

    "clusterBkg": "#f6f8fa",
    "clusterBorder": "#d0d7de",

    "edgeLabelBackground": "#f6f8fa",

    "actorBkg": "#ffffff",
    "actorBorder": "#8c959f",
    "actorTextColor": "#24292f",
    "actorLineColor": "#d0d7de",

    "signalColor": "#57606a",
    "signalTextColor": "#24292f",

    "noteBkgColor": "#fff8c5",
